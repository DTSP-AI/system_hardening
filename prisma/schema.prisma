// Prisma schema for BOS1 (single-tenant). One database per deployment; there is no
// tenant scoping. Access is gated by the User allowlist (see model User) and
// Clerk sign-in. Single-tenant deployment, one DB per deployment, so RLS does not
// apply (see CLAUDE.md "Deviations from global laws").

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum DealPriority {
  LOW
  MEDIUM
  HIGH
}

enum ActivityType {
  NOTE
  TASK
  CALL
  TEXT
  EMAIL
  MEETING
}

enum CustomFieldEntityType {
  CONTACT
  COMPANY
  DEAL
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  BOOLEAN
}

enum TodoQuadrant {
  URGENT_IMPORTANT
  SCHEDULE
  DELEGATE
  BACK_BURNER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

enum ContactType {
  CUSTOMER
  VENDOR
  PARTNER
}

enum TaggableEntityType {
  CONTACT
  COMPANY
  DEAL
  LEAD
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum NotificationType {
  ACTIVITY
  DEAL_STAGE_CHANGE
  LEAD_CONVERTED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique // lowercased; allowlist key
  clerkUserId   String?   @unique // null until first verified sign-in
  name          String?
  role          UserRole  @default(MEMBER)
  deactivatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

model Company {
  id           String   @id @default(cuid())
  name         String
  domain       String?
  industry     String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?
  ownerId      String?
  customFields Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contacts Contact[]
  deals    Deal[]

  @@map("companies")
}

model Contact {
  id           String      @id @default(cuid())
  firstName    String
  lastName     String
  email        String?
  phone        String?
  jobTitle     String?
  companyId    String?
  ownerId      String?
  leadSource   String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?
  type         ContactType @default(CUSTOMER)
  customFields Json        @default("{}")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  company    Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deals      Deal[]
  activities Activity[]

  @@index([companyId])
  @@map("contacts")
}

model PipelineStage {
  id        String   @id @default(cuid())
  name      String
  sortOrder Int
  isWon     Boolean  @default(false)
  isLost    Boolean  @default(false)
  color     String   @default("#2563EB")

  deals  Deal[]

  @@map("pipeline_stages")
}

model Deal {
  id                String     @id @default(cuid())
  name              String
  contactId         String?
  companyId         String?
  stageId           String
  amount            Decimal?     @db.Decimal(12, 2)
  currency          String       @default("USD")
  expectedCloseDate DateTime?
  closedAt          DateTime?
  ownerId           String?
  status            DealStatus   @default(OPEN)
  priority          DealPriority @default(MEDIUM)
  source            String?
  description       String?
  nextStep          String?
  customFields      Json         @default("{}")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  contact    Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company    Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  stage      PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  activities Activity[]

  @@index([stageId])
  @@map("deals")
}

model Activity {
  id          String       @id @default(cuid())
  type        ActivityType
  contactId   String?
  dealId      String?
  authorId    String
  dueDate     DateTime?
  completedAt DateTime?
  body        String?
  metadata    Json         @default("{}")
  createdAt   DateTime     @default(now())

  contact Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal    Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([dealId])
  @@map("activities")
}

model CustomFieldDefinition {
  id         String                 @id @default(cuid())
  entityType CustomFieldEntityType
  key        String
  label      String
  fieldType  CustomFieldType
  options    Json                   @default("[]")
  required   Boolean                @default(false)
  sortOrder  Int                    @default(0)


  @@unique([entityType, key])
  @@map("custom_field_definitions")
}

model ApiKey {
  id              String    @id @default(cuid())
  name            String
  hashedKey       String    @unique
  createdByUserId String
  expiresAt       DateTime?
  revokedAt       DateTime?
  lastUsedAt      DateTime?
  createdAt       DateTime  @default(now())


  @@map("api_keys")
}

/// A prospect who hasn't been qualified into a Contact/Company yet.
/// `convert` on the lead router creates a real Contact (and Company, if
/// companyName is set) and stamps convertedContactId + status CONVERTED --
/// leads are never deleted on conversion, just marked terminal.
model Lead {
  id                 String     @id @default(cuid())
  firstName          String
  lastName           String
  email              String?
  phone              String?
  companyName        String?
  jobTitle           String?
  source             String?
  status             LeadStatus @default(NEW)
  ownerId            String?
  convertedContactId String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt


  @@map("leads")
}

/// Personal Eisenhower-matrix todos shown on each user's home dashboard --
/// scoped to authorId (the Clerk user who owns them), never shared.
model Todo {
  id        String       @id @default(cuid())
  authorId  String
  title     String
  quadrant  TodoQuadrant
  completed Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt


  @@index([authorId])
  @@map("todos")
}

model Tag {
  id        String   @id @default(cuid())
  name      String
  color     String
  createdAt DateTime @default(now())

  assignments TagAssignment[]

  @@unique([name])
  @@map("tags")
}

/// Polymorphic join, same shape as Activity's contactId/dealId pattern but
/// generalized to entityType+entityId since Tags apply to four entity kinds.
model TagAssignment {
  id         String             @id @default(cuid())
  tagId      String
  entityType TaggableEntityType
  entityId   String
  createdAt  DateTime           @default(now())

  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([tagId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("tag_assignments")
}

model Attachment {
  id           String             @id @default(cuid())
  entityType   TaggableEntityType
  entityId     String
  fileName     String
  fileUrl      String
  fileSize     Int
  mimeType     String
  uploadedById String
  createdAt    DateTime           @default(now())


  @@index([entityType, entityId])
  @@map("attachments")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  linkHref  String?
  readAt    DateTime?
  createdAt DateTime         @default(now())


  @@index([userId])
  @@map("notifications")
}

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String
  entityType String
  entityId   String
  action     AuditAction
  diff       Json?
  createdAt  DateTime    @default(now())


  @@index([entityType, entityId])
  @@map("audit_logs")
}


model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@map("rate_limit_hits")
}
