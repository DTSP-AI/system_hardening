// Prisma schema for the YBRYX CRM rebuild.
// Multi-tenant core: every tenant-owned table carries a tenantId, enforced both by
// the Prisma Client Extension (src/lib/db.ts) and by Postgres RLS (prisma/rls.sql).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum DealPriority {
  LOW
  MEDIUM
  HIGH
}

enum ActivityType {
  NOTE
  TASK
  CALL
  TEXT
  EMAIL
  MEETING
}

enum CustomFieldEntityType {
  CONTACT
  COMPANY
  DEAL
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  BOOLEAN
}

enum TodoQuadrant {
  URGENT_IMPORTANT
  SCHEDULE
  DELEGATE
  BACK_BURNER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

enum ContactType {
  CUSTOMER
  VENDOR
  PARTNER
}

enum TaggableEntityType {
  CONTACT
  COMPANY
  DEAL
  LEAD
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum NotificationType {
  ACTIVITY
  DEAL_STAGE_CHANGE
  LEAD_CONVERTED
}

model Tenant {
  id          String   @id @default(cuid())
  clerkOrgId  String   @unique
  name        String
  slug        String   @unique
  planTier    String   @default("free")
  settings    Json     @default("{}")
  smsPhoneNumber String? @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships          Membership[]
  companies            Company[]
  contacts             Contact[]
  pipelineStages       PipelineStage[]
  deals                Deal[]
  activities           Activity[]
  customFieldDefs      CustomFieldDefinition[]
  apiKeys              ApiKey[]
  todos                Todo[]
  leads                Lead[]
  tags                 Tag[]
  tagAssignments       TagAssignment[]
  notifications        Notification[]
  attachments          Attachment[]
  auditLogs            AuditLog[]

  @@map("tenants")
}

model Membership {
  id           String         @id @default(cuid())
  tenantId     String
  clerkUserId  String
  role         MembershipRole @default(MEMBER)
  createdAt    DateTime       @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, clerkUserId])
  @@index([tenantId])
  @@map("memberships")
}

model Company {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  domain       String?
  industry     String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?
  ownerId      String?
  customFields Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts Contact[]
  deals    Deal[]

  @@index([tenantId])
  @@map("companies")
}

model Contact {
  id           String      @id @default(cuid())
  tenantId     String
  firstName    String
  lastName     String
  email        String?
  phone        String?
  jobTitle     String?
  companyId    String?
  ownerId      String?
  leadSource   String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?
  type         ContactType @default(CUSTOMER)
  customFields Json        @default("{}")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company    Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deals      Deal[]
  activities Activity[]

  @@index([tenantId])
  @@index([companyId])
  @@map("contacts")
}

model PipelineStage {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  sortOrder Int
  isWon     Boolean  @default(false)
  isLost    Boolean  @default(false)
  color     String   @default("#2563EB")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deals  Deal[]

  @@index([tenantId])
  @@map("pipeline_stages")
}

model Deal {
  id                String     @id @default(cuid())
  tenantId          String
  name              String
  contactId         String?
  companyId         String?
  stageId           String
  amount            Decimal?     @db.Decimal(12, 2)
  currency          String       @default("USD")
  expectedCloseDate DateTime?
  closedAt          DateTime?
  ownerId           String?
  status            DealStatus   @default(OPEN)
  priority          DealPriority @default(MEDIUM)
  source            String?
  description       String?
  nextStep          String?
  customFields      Json         @default("{}")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact    Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company    Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  stage      PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  activities Activity[]

  @@index([tenantId])
  @@index([stageId])
  @@map("deals")
}

model Activity {
  id          String       @id @default(cuid())
  tenantId    String
  type        ActivityType
  contactId   String?
  dealId      String?
  authorId    String
  dueDate     DateTime?
  completedAt DateTime?
  body        String?
  metadata    Json         @default("{}")
  createdAt   DateTime     @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal    Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([contactId])
  @@index([dealId])
  @@map("activities")
}

model CustomFieldDefinition {
  id         String                 @id @default(cuid())
  tenantId   String
  entityType CustomFieldEntityType
  key        String
  label      String
  fieldType  CustomFieldType
  options    Json                   @default("[]")
  required   Boolean                @default(false)
  sortOrder  Int                    @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, entityType, key])
  @@index([tenantId])
  @@map("custom_field_definitions")
}

model ApiKey {
  id              String    @id @default(cuid())
  tenantId        String
  name            String
  hashedKey       String    @unique
  createdByUserId String
  expiresAt       DateTime?
  revokedAt       DateTime?
  lastUsedAt      DateTime?
  createdAt       DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("api_keys")
}

/// A prospect who hasn't been qualified into a Contact/Company yet.
/// `convert` on the lead router creates a real Contact (and Company, if
/// companyName is set) and stamps convertedContactId + status CONVERTED --
/// leads are never deleted on conversion, just marked terminal.
model Lead {
  id                 String     @id @default(cuid())
  tenantId           String
  firstName          String
  lastName           String
  email              String?
  phone              String?
  companyName        String?
  jobTitle           String?
  source             String?
  status             LeadStatus @default(NEW)
  ownerId            String?
  convertedContactId String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("leads")
}

/// Personal Eisenhower-matrix todos shown on each user's home dashboard --
/// scoped to tenant + authorId (the Clerk user who owns them), never shared.
model Todo {
  id        String       @id @default(cuid())
  tenantId  String
  authorId  String
  title     String
  quadrant  TodoQuadrant
  completed Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([authorId])
  @@map("todos")
}

model Tag {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  color     String
  createdAt DateTime @default(now())

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments TagAssignment[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("tags")
}

/// Polymorphic join, same shape as Activity's contactId/dealId pattern but
/// generalized to entityType+entityId since Tags apply to four entity kinds.
model TagAssignment {
  id         String             @id @default(cuid())
  tenantId   String
  tagId      String
  entityType TaggableEntityType
  entityId   String
  createdAt  DateTime           @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([tagId, entityType, entityId])
  @@index([tenantId])
  @@index([entityType, entityId])
  @@map("tag_assignments")
}

model Attachment {
  id           String             @id @default(cuid())
  tenantId     String
  entityType   TaggableEntityType
  entityId     String
  fileName     String
  fileUrl      String
  fileSize     Int
  mimeType     String
  uploadedById String
  createdAt    DateTime           @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([entityType, entityId])
  @@map("attachments")
}

model Notification {
  id        String           @id @default(cuid())
  tenantId  String
  userId    String
  type      NotificationType
  title     String
  body      String?
  linkHref  String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("notifications")
}

model AuditLog {
  id         String      @id @default(cuid())
  tenantId   String
  actorId    String
  entityType String
  entityId   String
  action     AuditAction
  diff       Json?
  createdAt  DateTime    @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

