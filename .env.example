# Copy to .env and fill in. Never commit .env.

# Neon Postgres connection string (one database per deployment)
DATABASE_URL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Twilio Voice
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_CALLER_ID=

# Vercel Blob (attachments)
BLOB_READ_WRITE_TOKEN=
# Set by Vercel when a Blob store is linked; either this or the token enables uploads
BLOB_STORE_ID=

# Resend (email)
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# Command line client (npm run cli) and other external agents. Not read by the app itself.
# BOS1_URL is the deployed site, e.g. https://crm.example.com. Create the key under Admin > API Keys.
BOS1_URL=
BOS1_API_KEY=

# Server tests only. Optional: defaults to the local Docker container started by scripts/test-db.ts.
# Must point at this machine; the tests refuse any other host.
TEST_DATABASE_URL=
